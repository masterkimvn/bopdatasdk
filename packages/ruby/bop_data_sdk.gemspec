Gem::Specification.new do |s|
  s.name = 'bop-data-sdk'
  s.version = '1.0.0'
  s.summary = 'Read-only client for BOP Data'
  s.description = 'Small Ruby connector for BOP Data public structured datasets.'
  s.authors = ['Phạm Hoàng Đức (Master Kim)']
  s.homepage = 'https://data.bop.ink'
  s.license = 'MIT'
  s.files = ['lib/bop_data.rb', 'README.md', 'LICENSE']
  s.required_ruby_version = '>= 3.0'
  s.metadata = {
    'source_uri' => 'https://github.com/masterkimvn/bopdatasdk',
    'homepage_uri' => 'https://data.bop.ink',
    'bug_tracker_uri' => 'https://github.com/masterkimvn/bopdatasdk/issues'
  }
end
