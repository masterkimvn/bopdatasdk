{
  "name": "bopink/data-sdk",
  "description": "Read-only PHP client for BOP Data public structured datasets",
  "type": "library",
  "license": "MIT",
  "homepage": "https://data.bop.ink",
  "authors": [
    {
      "name": "Phạm Hoàng Đức (Master Kim)",
      "homepage": "https://about.bop.ink"
    }
  ],
  "keywords": [
    "bop-data",
    "datasets",
    "structured-data",
    "csv"
  ],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "BopData\\": "src/"
    }
  },
  "support": {
    "source": "https://github.com/masterkimvn/bopdatasdk",
    "issues": "https://github.com/masterkimvn/bopdatasdk/issues"
  },
  "archive": {
    "exclude": [
      "/vendor/",
      "/composer.lock",
      "/test.php"
    ]
  }
}
